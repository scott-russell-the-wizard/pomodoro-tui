# Pomodoro TUI Configuration Overrides
# Default durations in minutes
POMODORO_WORK_MINUTES=25
POMODORO_SHORT_BREAK_MINUTES=5
POMODORO_LONG_BREAK_MINUTES=15
POMODORO_LONG_BREAK_INTERVAL=4
POMODORO_DAILY_GOAL=8

# Notification Settings (true/false)
POMODORO_SOUND_ENABLED=true
POMODORO_DESKTOP_NOTIFY=false

# Auto-start options (true/false)
POMODORO_AUTO_START_BREAKS=false
POMODORO_AUTO_START_WORK=false
